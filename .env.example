APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

SCAN_REGIONS=UK,Europe,USA,Canada
SUPPLEMENT_CATEGORIES=vitamins,minerals,supplements,protein,whey,creatine,pre-workout,collagen,gummies,electrolytes,greens,probiotics,omega 3,magnesium,pet supplements,dog supplements,cat supplements
SUPPLEMENT_RELEVANCE_INCLUDE_KEYWORDS=supplement,supplements,vitamin,vitamins,multivitamin,mineral supplement,trace minerals,protein,protein powder,whey,creatine,pre workout,collagen,gummy,gummies,electrolyte,electrolytes,greens powder,super greens,daily greens,probiotic,probiotics,omega 3,magnesium,wellness supplement,pet supplement,pet supplements,dog supplement,dog supplements,cat supplement,cat supplements,sports nutrition,gym nutrition,amino acid,amino acids,bcaa,hydration powder,meal replacement,nutrition shake,fish oil
SUPPLEMENT_RELEVANCE_EXCLUDE_KEYWORDS=kiwifruit,fresh produce,produce company,produce market,fruit company,fruit grower,fruit growers,greengrocer,grocery store,supermarket,restaurant,food delivery,hair care,haircare,shampoo,conditioner,skin care,skincare,cosmetics,makeup,mineral specimen,mineral specimens,gemstone,gemstones,crystal shop,jewelry,jewellery,clothing,apparel,gym equipment
TARGET_MIN_MONTHLY_SPEND_USD=5000
TARGET_MAX_MONTHLY_SPEND_USD=30000
SPEND_ESTIMATION_ENABLED=true
SPEND_TARGET_MIN_USD=5000
SPEND_TARGET_MAX_USD=30000
# Directional assumptions, not observed Meta spend. Tune deliberately by region.
SPEND_CPM_UK_LOW_USD=8
SPEND_CPM_UK_HIGH_USD=18
SPEND_CPM_EUROPE_LOW_USD=5
SPEND_CPM_EUROPE_HIGH_USD=18
SPEND_CPM_USA_LOW_USD=10
SPEND_CPM_USA_HIGH_USD=25
SPEND_CPM_CANADA_LOW_USD=8
SPEND_CPM_CANADA_HIGH_USD=20
SPEND_REACH_FREQUENCY_LOW=1
SPEND_REACH_FREQUENCY_HIGH=3
SPEND_ACTIVITY_DAILY_LOW_USD=10
SPEND_ACTIVITY_DAILY_HIGH_USD=50
SPEND_MIN_OBSERVATION_DAYS=7
TARGET_MIN_INSTAGRAM_FOLLOWERS=10000
TARGET_MAX_INSTAGRAM_FOLLOWERS=100000
DESIRABLE_TRUSTPILOT_REVIEW_COUNT=300
SCAN_INTERVAL_HOURS=12
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_MIN_WAIT_SECONDS=1
PROVIDER_RETRY_MAX_WAIT_SECONDS=10

DATABASE_URL=
PERSIST_SCAN_RESULTS=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10

META_ACCESS_TOKEN=
META_AD_PROVIDER=apify
META_API_VERSION=v26.0
META_REQUEST_TIMEOUT_SECONDS=30
META_MAX_PAGES_PER_QUERY=100

APIFY_API_TOKEN=
APIFY_ACTOR_ID=solidcode/meta-ads-library-scraper
APIFY_MAX_RESULTS_PER_QUERY=500
APIFY_MAX_TOTAL_CHARGE_USD_PER_RUN=0.02
APIFY_INCLUDE_ADVERTISER_DETAILS=true
APIFY_MONTHLY_BUDGET_GBP=30
# Conservative default: account usage in USD is treated as the same number of GBP.
APIFY_BUDGET_GBP_PER_USD=1.0
APIFY_REQUEST_TIMEOUT_SECONDS=120
APIFY_TRUSTPILOT_ACTOR_ID=automation-lab/trustpilot-scraper
APIFY_TRUSTPILOT_MAX_TOTAL_CHARGE_USD_PER_RUN=0.01

GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=1m6DRz8GzhW_Xn297WDfa-amZHMFn9v8qqhvRLzlIy84
GOOGLE_SHEET_TAB=Candidates
GOOGLE_SERVICE_ACCOUNT_JSON=

INSTAGRAM_PROVIDER=
INSTAGRAM_API_KEY=

REVIEWS_PROVIDER=apify_trustpilot
REVIEWS_API_KEY=
REVIEWS_ENABLED=false
TRUSTPILOT_API_KEY=
TRUSTPILOT_MIN_DESIRABLE_REVIEWS=300
# Trustpilot requires displayed cached API data to refresh at least every 24 hours.
TRUSTPILOT_REFRESH_HOURS=24
TRUSTPILOT_REQUEST_TIMEOUT_SECONDS=30
TRUSTPILOT_MIN_REQUEST_INTERVAL_SECONDS=0.4
